# Sciver configuration example; the runtime still uses ~/.config/theory-master/env for compatibility.
# Replace values locally. NEVER commit real credentials or personal hostnames.
# THEORYMASTER_PROFILE=1
# THEORYMASTER_SCHOLARLY_PYTHON=/path/to/scientific/python
# THEORYMASTER_ACCOUNT_HOME=/path/to/.codex-accounts
# THEORYMASTER_CODEX_BIN=/path/to/codex
# THEORYMASTER_WEB_URL=http://127.0.0.1:8787/
# TM_OBSERVER_PUBLIC_HOSTNAME=your-private-hostname.example
# TM_OBSERVER_AL_HOST=your-tunnel-server.example
# TM_OBSERVER_AL_USER=tmobserver
# TM_OBSERVER_AL_PORT=8453
# THEORYMASTER_NOTIFY_TO=you@example.com
# AUTO_SUBMIT_SMTP_USER=you@example.com
# AUTO_SUBMIT_SMTP_PASSWORD=
